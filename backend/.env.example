DATABASE_URL=file:./dev.db
SECRET_KEY=dev-secret
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
NODE_ENV=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CACHE_DURATION_MINUTES=15
RISK_FREE_RATE=0.07
DEFAULT_MARKET_SUFFIX=.NS
LOG_LEVEL=info
# Optional: free tier at finnhub.io — company news + earnings calendar
FINNHUB_API_KEY=
# Optional: free key from ipoguru.in — live IPO GMP + subscription enrichment
IPO_GURU_API_KEY=

# Public URL of the web app, used in email links
APP_URL=http://localhost:5173

# Optional: Google Sign-In. Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add http://localhost:5173
# as an authorised JavaScript origin. Use the SAME value for the frontend's
# VITE_GOOGLE_CLIENT_ID so token audience validation succeeds.
GOOGLE_CLIENT_ID=

# Optional: SMTP for email notifications. Without these, emails are logged
# to the server console instead of being sent (nothing breaks).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Portfolio Optimizer <no-reply@localhost>
